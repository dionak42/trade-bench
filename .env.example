# Trade Bench — API keys and config.
# Copy this to ".env" (the setup script does that for you), then fill in your keys.
# Tip: you can skip this file entirely and add your keys in the app's ⚙ Settings screen.

# Alpaca — prices, options chains, and paper trading. Use PAPER-account keys.
# Get them at https://app.alpaca.markets (keep the "Paper" toggle on) → API Keys.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Finnhub — news, earnings calendar, and symbol search (free tier).
# Get a key at https://finnhub.io/dashboard
FINNHUB_API_KEY=

# Port the app runs on (3000 is the default).
PORT=3000
